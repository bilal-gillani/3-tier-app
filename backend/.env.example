# ================================================
# E-Commerce Backend - Environment Placeholders
# ================================================

# Server
PORT=3000
NODE_ENV=dev/production

# Database (MySQL on Database VM / Azure MySQL Flexible Server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=db-user
DB_PASSWORD=db-password
DB_NAME=db-name

# JWT
JWT_SECRET=jwt-secret-goes-here
JWT_EXPIRES_IN=7d

# CORS (Frontend VM public IP or domain)
CORS_ORIGIN=[IP_ADDRESS]
