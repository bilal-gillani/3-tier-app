# ================================================
# E-Commerce Store - Backend Configuration (.env)
# Copy this file to .env and configure your values
# ================================================

# Server Settings
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL)
# Single-VM Setup: 127.0.0.1
# Multi-VM Setup:  Database VM Private IP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ecommerce_user
DB_PASSWORD=YourStrongPasswordHere!
DB_NAME=ecommerce_store

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration
# Single-VM: * or http://localhost
# Multi-VM:  http://<FRONTEND_PUBLIC_IP_OR_DOMAIN>
CORS_ORIGIN=*
